# 1. Define error log relative to your project folder
error_log logs/error.log;

# 2. Define where to store the Process ID file
pid       logs/nginx.pid;

events { worker_connections 1024; 
}

http{
    # 3. Define access log relative to project
    access_log logs/access.log;

    # 4. Define temp paths (crucial for uploads/body parsing)
    client_body_temp_path temp/client_body_temp;
    proxy_temp_path       temp/proxy_temp;
    fastcgi_temp_path     temp/fastcgi_temp;
    uwsgi_temp_path       temp/uwsgi_temp;
    scgi_temp_path        temp/scgi_temp;

	#include       /etc/nginx/mime.types;
	include			mime.types;
	#include /etc/nginx/fastcgi_params;
    include 		fastcgi_params;
	default_type  application/octet-stream;
	
 	# =============================================================
    # SERVER 1 (Corresponds to serverConf1)
    # =============================================================
	server{

		listen 127.0.0.1:8081;
		server_name Hello;
		# webserv::test::testMaxBodySize() -> 100,000 bytes
		client_max_body_size 100000;

		# Error Pages Map
		# Note: In NGINX, we define where the file is located relative to root
		error_page 400 /pages/Alps/error/400.html;
		error_page 401 /pages/Alps/error/401.html;
		error_page 403 /pages/Alps/error/403.html;
		error_page 404 /pages/Alps/error/404.html;
		error_page 500 /pages/Alps/error/500.html;
		error_page 502 /pages/Alps/error/502.html;
		error_page 503 /pages/Alps/error/503.html;
		error_page 504 /pages/Alps/error/504.html;

		# We need a location to serve the error pages from the project root
		location ^~ /pages/Alps/error/ {
		    root ./; # Assumes running from project root
		    internal; # Only accessible via error redirections
		}
		# ---------------------------------------------------------
		# Route 1: /old-page
		# ---------------------------------------------------------
		location /old-page {
		    # Method: GET only
		    limit_except GET { deny all; 
			}
		    
		    # Redirection: 301
		    return 301 http://new-url.com;
		}

		# ---------------------------------------------------------
		# Route 2: / (Root)
		# ---------------------------------------------------------
		location / {
		    # Method: GET only
		    limit_except GET { deny all;
			}

		    # Config: Root "pages/Alps", Index "index.html", Autoindex 0
		    root pages/Alps;
		    index index.html;
		    autoindex off;
		}
	}
	# =============================================================
    # SERVER 2 (Corresponds to serverConf2)
    # =============================================================
    server {
        listen 127.0.0.1:9001;
		server_name Hello;

		# webserv::test::testMaxBodySize() -> 100 bytes (Very strict!)
		client_max_body_size 120000;

		# Error Pages (Same mapping)
		error_page 400 /pages/Alps/error/400.html;
		error_page 401 /pages/Alps/error/401.html;
		error_page 403 /pages/Alps/error/403.html;
		error_page 404 /pages/Alps/error/404.html;
		error_page 500 /pages/Alps/error/500.html;
		error_page 502 /pages/Alps/error/502.html;
		error_page 503 /pages/Alps/error/503.html;
		error_page 504 /pages/Alps/error/504.html;

		location ^~ /pages/Alps/error/ {
		    root ./;
		    internal;
		}

		# ---------------------------------------------------------
		# Route 2: / (Reused from Server 1 logic)
		# ---------------------------------------------------------
		location / {
		    limit_except GET { deny all; 
			}
		    root pages/Alps;
		    index index.html;
		    autoindex off;
		}
		# ---------------------------------------------------------
        # Route 3: Uploads
        # ---------------------------------------------------------
        location /upload.php {
            # Allow POST for uploads
            limit_except POST { deny all;
			}
            root pages/Alps; 
            # Pass to PHP-CGI to handle the actual saving
            #include /etc/nginx/fastcgi_params;
			include 		fastcgi_params;
            fastcgi_pass 127.0.0.1:9002;
            fastcgi_index upload.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }

        # Serve the uploaded files so we can verify they exist
        location /uploads/ {
            root pages/Alps;
            autoindex on; # Turn on directory listing to see uploaded files
            limit_except GET { deny all; 
			}
        }

		# ---------------------------------------------------------
		# Route 4: /cgi
		# ---------------------------------------------------------
		location /cgi/ {
		    # Method: GET POST
		    limit_except GET POST { deny all; 
			}

		    # Root path was empty string in C++, implying default/current
		    root ./;

		    # CGI CONFIGURATION
		    # NGINX does not support direct binary execution like your 
		    # "/usr/bin/php-cgi" instruction. It needs a socket.
		    # Below is standard PHP-FPM config.
		    
		    location ~ \.php$ {
		        # Assumption: PHP-FPM is listening on port 9000 or a socket
		        # If you cannot run PHP-FPM, you cannot fully compare CGI 
		        # behavior with NGINX, only the routing logic.
		        fastcgi_pass 127.0.0.1:9002; # Changed port to avoid conflict with this server
		        fastcgi_index index.php;
		        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		    }
		}
	}
}		
